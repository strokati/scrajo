{
	"name": "@scrajo/api",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:migrate": "prisma migrate dev",
		"db:generate": "prisma generate",
		"db:push": "prisma db push"
	},
	"dependencies": {
		"@fastify/cors": "^11.0.0",
		"@prisma/client": "^6.9.0",
		"@scrajo/shared": "workspace:*",
		"bullmq": "^5.53.0",
		"dotenv": "^17.4.2",
		"fastify": "^5.3.0",
		"fastify-plugin": "^5.0.0",
		"fastify-type-provider-zod": "^4.0.0",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"prisma": "^6.9.0",
		"tsx": "^4.19.0",
		"typescript": "^5.8.0",
		"vitest": "^3.2.0"
	}
}
