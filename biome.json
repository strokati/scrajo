{
	"$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
	"root": true,
	"files": {
		"includes": [
			"**/*.ts",
			"**/*.js",
			"**/*.json",
			"**/*.css",
			"**/*.html",
			"!!**/node_modules",
			"!!**/dist",
			"!!**/build",
			"!!**/generated",
			"!!**/.pnpm-store"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"json": {
		"formatter": {
			"trailingCommas": "none"
		}
	},
	"linter": {
		"rules": {
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error"
			},
			"suspicious": {
				"noConsole": "warn",
				"noExplicitAny": "warn"
			},
			"style": {
				"useConst": "error",
				"useTemplate": "warn"
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": { "maxAllowedComplexity": 20 }
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.test.*", "**/*.spec.*"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off",
						"noExplicitAny": "off"
					}
				}
			}
		}
	]
}
